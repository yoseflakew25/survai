#!/usr/bin/env bash
# Local API: ./run
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -x .venv/bin/uvicorn ]]; then
  echo "Missing .venv — run once:"
  echo "  uv python install 3.12 && uv venv --python 3.12 .venv && uv pip install -r requirements.txt"
  exit 1
fi

exec .venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8000 "$@"
