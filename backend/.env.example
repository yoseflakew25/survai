# Copy to .env for local development
ENVIRONMENT=development
DEBUG=true
APP_NAME=SurvAI API
API_V1_PREFIX=/api/v1

# Local Docker Postgres:
# DATABASE_URL=postgresql+asyncpg://survai:survai@localhost:5432/survai
# DATABASE_SSL=false
#
# Managed (Aiven / Neon / etc.) — ssl required:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/defaultdb
DATABASE_URL=postgresql+asyncpg://survai:survai@localhost:5432/survai
DATABASE_SSL=false
# Optional: path to Aiven CA PEM for full cert verification
# DATABASE_SSL_CA=./certs/aiven-ca.pem
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_PATH=/auth/reset-password

JWT_SECRET_KEY=dev-change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=SurvAI

# EmailStr rejects reserved TLDs like .local — use example.com (or your real domain)
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
FIRST_SUPERUSER_FULL_NAME=SurvAI Admin
