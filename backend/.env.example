# Copy to .env for local development
ENVIRONMENT=development
DEBUG=true
APP_NAME=SurvAI API
API_V1_PREFIX=/api/v1

# Local Docker Postgres:
# DATABASE_URL=postgresql+asyncpg://survai:survai@localhost:5432/survai
# DATABASE_SSL=false
#
# Managed (Aiven / Neon / etc.) — ssl required:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/defaultdb
DATABASE_URL=postgresql+asyncpg://survai:survai@localhost:5432/survai
DATABASE_SSL=false
# Optional: path to Aiven CA PEM for full cert verification
# DATABASE_SSL_CA=./certs/aiven-ca.pem
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_PATH=/auth/reset-password

# Production rejects weak/placeholder secrets (use: openssl rand -hex 32)
JWT_SECRET_KEY=dev-change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# Email — SMTP (default). Optional Resend only if SMTP is disabled / unset.
# Gmail on Render: use an App Password; if sends hang/fail from cloud IPs, try
# SMTP_PORT=465 (implicit TLS) or another SMTP host (Brevo/Mailgun/etc.).
RESEND_API_KEY=
EMAILS_FROM_EMAIL=yoseflakewdev@gmail.com
EMAILS_FROM_NAME=SurvAI

SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Platform system admin (created on API startup if missing; password is NOT
# reset on later boots — change via forgot-password or profile).
# EmailStr rejects reserved TLDs like .local — use a real domain.
# Production requires a strong FIRST_SUPERUSER_PASSWORD (≥12 chars, not defaults).
FIRST_SUPERUSER_EMAIL=yoseflakewdev@gmail.com
FIRST_SUPERUSER_PASSWORD=12121212
FIRST_SUPERUSER_FULL_NAME=SurvAI System Admin
FIRST_SUPERUSER_ORGANIZATION_NAME=SurvAI

# AI — Gemini (google-genai). All calls go through app/ai/client.py.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Prefer lite models with available free-tier quota; flash variants often hit caps / 503s.
GEMINI_MODEL_PLANNER=gemini-3.1-flash-lite
GEMINI_MODEL_BUILDER=gemini-3.1-flash-lite
GEMINI_MODEL_REVIEWER=gemini-3.1-flash-lite
GEMINI_MODEL_REPORT=gemini-3.1-flash-lite
GEMINI_MODEL_CHAT=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash

# ARQ / Redis — leave empty to run AI jobs inline on the API process.
# Local: docker compose --profile jobs up
# Free prod: Upstash Redis → paste rediss://… URL; start.sh runs the worker beside uvicorn.
# REDIS_URL=redis://localhost:6379
REDIS_URL=redis-cli --tls -u redis://default:gQAAAAAAA7JcAAIgcDFhZjE4MmIyODgwMGI0Nzg2ODJlYjI3ZDc1MTg0OTcxZQ@crucial-gnu-242268.upstash.io:6379
