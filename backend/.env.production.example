ENVIRONMENT=production
DEBUG=false
APP_NAME=SurvAI API

POSTGRES_USER=survai
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=survai

# Compose Postgres on the same host, OR managed (Aiven) with SSL:
# DATABASE_URL=postgresql+asyncpg://avnadmin:PASSWORD@HOST:PORT/defaultdb
# DATABASE_SSL=true
DATABASE_SSL=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

JWT_SECRET_KEY=replace-with-openssl-rand-hex-64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=.example.com

# Required for signup OTP + forgot-password emails (or set RESEND_API_KEY).
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=SurvAI
# RESEND_API_KEY=

FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-strong-password
FIRST_SUPERUSER_FULL_NAME=SurvAI Admin

API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
